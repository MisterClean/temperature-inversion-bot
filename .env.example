BSKY_HANDLE=your-handle.bsky.social
BSKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

TZ=America/Chicago
PROFILE_SOURCE_MODE=actual
PRIMARY_STATION=74560
SECONDARY_STATION=
# Optional custom coordinates for primary/secondary:
# PRIMARY_LATITUDE=41.9742
# PRIMARY_LONGITUDE=-87.9073
# PRIMARY_ELEVATION_M=204
# SECONDARY_LATITUDE=41.7868
# SECONDARY_LONGITUDE=-87.7522
# SECONDARY_ELEVATION_M=188
POST_TIME_MORNING=07:30
POST_TIME_AFTERNOON=15:30
MAX_POSTS_PER_DAY=2
AFTERNOON_CONFIDENCE_THRESHOLD=0.55

# Wyoming sounding settings (used in actual mode)
WYOMING_SOUNDING_URL=https://weather.uwyo.edu/wsgi/sounding
WYOMING_SOURCE=BUFR

# Forecast settings (used in forecast mode)
OPEN_METEO_URL=https://api.open-meteo.com/v1/gfs
OPEN_METEO_MODEL=

STATE_FILE=var/state.json
DRY_RUN=true
